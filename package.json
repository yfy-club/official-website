{
  "name": "yfy-trajectory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "build:quality": "node scripts/run-next.mjs build --turbopack",
    "start": "next start",
    "start:quality": "node scripts/run-next.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:e2e": "npm run build:quality && playwright test",
    "test:e2e:run": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "audit:docs": "node scripts/docs-audit.mjs",
    "audit:content": "node scripts/content-audit.mjs",
    "audit:images": "node scripts/image-audit.mjs",
    "images:optimize": "node scripts/optimize-images.mjs --replace",
    "fonts:extract": "node --experimental-strip-types scripts/extract-heading-glyphs.ts",
    "fonts:subset": "npm run fonts:extract && node --experimental-strip-types scripts/subset-heading-font.ts",
    "fonts:check": "npm run fonts:extract && python scripts/check-font-coverage.py",
    "lighthouse": "npm run build:quality && lhci autorun",
    "lighthouse:run": "lhci autorun",
    "check": "npm run typecheck && npm run lint && npm run test && npm run audit:docs && npm run audit:content && npm run audit:images && npm run fonts:check && npm run build:quality"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "15.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.85.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
