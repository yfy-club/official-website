# Cloudflare Turnstile（Secret 仅服务端使用；本地留空会关闭验证）
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 报名通知（Webhook 支持飞书、企业微信和通用 JSON Webhook）
JOIN_WEBHOOK_URL=

# 报名邮件通知（Resend HTTP API，Node 与边缘运行时通用）
# JOIN_MAIL_FROM 必须使用在 Resend 中已验证的域名，留空会退回只能发给
# Resend 账号本人的沙盒发件人 onboarding@resend.dev，发往 QQ 邮箱会被拒收。
RESEND_API_KEY=
JOIN_MAIL_FROM=
JOIN_NOTIFY_EMAIL=

# Upstash Redis REST。同时承担跨实例限流与报名持久化。
# 留空时两者都退化为进程内实现：限流在多实例下失效，报名重启即丢失。
# 正式部署必须配置，否则通知失败的报名无法补投。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 报名记录保留天数，留空默认 180 天。
JOIN_RETENTION_DAYS=

# 补投接口 /api/join/retry 的鉴权密钥，留空时该接口关闭。
# 需与 GitHub 仓库 Secrets 中的 CRON_SECRET 一致。
CRON_SECRET=

# 站点公开配置
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_ID=
